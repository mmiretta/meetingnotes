# Speech-to-text service (faster-whisper).
# CPU by default; for NVIDIA GPUs build with
#   --build-arg BASE_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
# (docker-compose.gpu.yml does this for you).
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models

# ffmpeg decodes uploads; the CUDA base image also needs Python.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && if ! command -v python3 >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends python3 python3-pip; \
    fi \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY requirements-whisper.txt .
RUN python3 -m pip install --no-cache-dir -r requirements-whisper.txt

COPY whisper_server.py .
RUN mkdir -p /models

EXPOSE 9000
CMD ["python3", "-m", "uvicorn", "whisper_server:app", "--host", "0.0.0.0", "--port", "9000"]
