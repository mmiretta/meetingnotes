# Copy to .env and adjust. Every variable is optional unless noted.

# ── Web app ───────────────────────────────────────────────────────────────────
# Signs session cookies. Generate one with: openssl rand -hex 32
# If empty, a random key is generated and stored in the data volume.
SECRET_KEY=
# Address and port published on the Docker host. Keep 127.0.0.1 behind a reverse proxy.
BIND_ADDRESS=127.0.0.1
PORT=5002
# First admin account, created on first start when there are no users yet
# (password: at least 8 characters). You can remove both after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# UI language when the browser does not ask for a supported one (en, es).
DEFAULT_LANGUAGE=en
# Set to 1 when the app is served over HTTPS.
SESSION_COOKIE_SECURE=0
MAX_UPLOAD_MB=500

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Seeds fictional users and meetings into an EMPTY data volume. Do not use with real data.
DEMO_MODE=0
DEMO_PASSWORD=demo

# ── Speech-to-text (Whisper) ──────────────────────────────────────────────────
# Default points at the optional "whisper" compose service.
WHISPER_URL=http://whisper:9000/transcribe
WHISPER_DEFAULT_MODEL=base
# cpu or cuda (cuda needs docker-compose.gpu.yml)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_TIMEOUT=3600

# ── Summaries (LLM) ───────────────────────────────────────────────────────────
# ollama, or openai for any OpenAI-compatible API (llama.cpp, vLLM, LM Studio...).
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OPENAI_BASE_URL=
OPENAI_API_KEY=
SUMMARY_MODEL=llama3.2:3b
# Languages in which every summary is generated (en, es).
SUMMARY_LANGUAGES=en,es
LLM_TIMEOUT=900
LLM_TEMPERATURE=0.7
# How many transcription/summary jobs may run at once.
JOB_CONCURRENCY=1

# ── Single sign-on through an authenticating reverse proxy (optional) ─────────
# Header carrying the user's e-mail, e.g. X-Auth-Request-Email (oauth2-proxy) or
# Remote-Email (Authelia). Leave empty to disable. Only existing users can sign in this way.
TRUSTED_AUTH_HEADER=
# Requests carrying the header are trusted only from these networks (the proxy).
TRUSTED_PROXY_CIDRS=127.0.0.1/32

LOG_LEVEL=INFO
